# Copy this file to `.env` and adjust the values to match your MySQL setup.
#   cp .env.example .env

# --- Application ---
APP_NAME="Library API Starter Kit"
DEBUG=true

# --- Database (MySQL) ---
# Adjust user / password / host / port / database name for your machine.
DB_USER=root
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_library
